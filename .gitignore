# Binaries
/genesis
/bin/
# Module binaries built locally (`go build ./...` in modules/* or
# test/modules/*, where the output binary takes the Go module's name).
genesis-module-*
genesis-test-module-*
module-linux-*
module-darwin-*
# `go build` without -o in a module writes an extensionless binary named
# after the module: any extensionless file at a module's root is ignored
# (sources all have an extension; subdirectories stay tracked).
/modules/*/*
/test/modules/*/*
!/modules/*/*.*
!/test/modules/*/*.*
!/modules/*/*/
!/test/modules/*/*/

# Go build artefacts
*.test
*.out

# IDEs / editors
.vscode/
.idea/
*.swp
/.bin/
