{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    {"type": "feat", "section": "Fonctionnalités"},
    {"type": "fix", "section": "Corrections"},
    {"type": "perf", "section": "Performances"},
    {"type": "refactor", "section": "Refactorisation"},
    {"type": "docs", "section": "Documentation"},
    {"type": "test", "section": "Tests", "hidden": true},
    {"type": "ci", "section": "Intégration continue", "hidden": true},
    {"type": "build", "section": "Build", "hidden": true},
    {"type": "chore", "section": "Maintenance", "hidden": true}
  ],
  "packages": {
    ".": {
      "package-name": "genesis",
      "component": "genesis",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["sdk"],
      "extra-files": [
        {"type": "generic", "path": "internal/version/version.go"}
      ]
    },
    "sdk": {
      "package-name": "sdk",
      "component": "sdk",
      "include-component-in-tag": true,
      "tag-separator": "/",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
